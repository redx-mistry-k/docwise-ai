# Copy this file to .env and replace the placeholder.
GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY is accepted as a compatibility alias when GOOGLE_API_KEY is absent.
# If both exist, DocWise explicitly uses GOOGLE_API_KEY without changing either value.
# GEMINI_MODEL is intentionally not used by the free-tier router.
# Configure only approved models in config/gemini_models.json.
GEMINI_ROUTING_MODE=balanced
# GEMINI_MODEL_CONFIG=config/gemini_models.json
# GEMINI_USAGE_DB=.docwise/gemini_usage.sqlite3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval and chunking defaults
RETRIEVAL_STRATEGY=hybrid
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_RELEVANCE_SCORE=0.15
ENABLE_RERANKING=true
HISTORY_AWARE=true
ADVANCED_RAG=true
QUERY_DECOMPOSITION=true
ADAPTIVE_RETRIEVAL=true
SELF_CORRECTING_RAG=true
ANSWER_VERIFICATION=true
MAX_RETRIEVAL_ATTEMPTS=2
MAX_SUBQUERIES=4
MAX_ADAPTIVE_TOP_K=10
MAX_CONTEXT_CHARACTERS=60000
MAX_CONTEXT_TOKENS=15000
# Advanced retrieval and verification are local and add zero Gemini calls by default.
MAX_ADDITIONAL_LLM_CALLS=0

# Reliability and storage
MAX_FILE_SIZE_MB=25
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
# DOCWISE_STORAGE_DIR=.docwise

# Recommended for any internet-accessible Streamlit deployment.
# DOCWISE_ACCESS_PASSWORD=replace_with_a_long_random_password
DOCWISE_QUERY_RPM=10
